# Sanitized template. Copy to ignored .env.r2.local and replace every
# placeholder there. Use DOVIDEO_PROFILE=production for the full Compose/API/
# Celery composition. The default local profile is for development only.
# DOVIDEO_* names are retained for configuration compatibility with VideoMind.
DOVIDEO_PROFILE=local
DOVIDEO_R2_DATA_ROOT=./work/docker-data
DOVIDEO_DATABASE_URL=mysql+pymysql://dovideo:replace-me@127.0.0.1:3306/media_db
DOVIDEO_REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
DOVIDEO_MINIO_ENDPOINT=127.0.0.1:9000
DOVIDEO_MINIO_ACCESS_KEY=replace-me
DOVIDEO_MINIO_SECRET_KEY=replace-me
DOVIDEO_MINIO_BUCKET=media
DOVIDEO_MINIO_SECURE=false
DOVIDEO_QDRANT_URL=http://127.0.0.1:6333
DOVIDEO_QDRANT_API_KEY=replace-me
DOVIDEO_QDRANT_COLLECTION=video_chunks
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_APP_USER=dovideo
DB_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
QDRANT_API_KEY=replace-me

# Configure one structured chat transport for real analysis. These are
# examples only; leave unused choices commented out.
# DOVIDEO_MODEL_TRANSPORT=openai-compatible
# DOVIDEO_MODEL_BASE_URL=https://example.invalid/v1
# DOVIDEO_MODEL_API_KEY=replace-me
# DOVIDEO_MODEL_MODEL=your-structured-chat-model

# Required for the full R4 production analysis path. Use a provider that serves
# BAAI/bge-m3 through an OpenAI-compatible /embeddings endpoint.
# DOVIDEO_EMBEDDING_BASE_URL=https://example.invalid/v1
# DOVIDEO_EMBEDDING_API_KEY=replace-me
# DOVIDEO_EMBEDDING_MODEL=BAAI/bge-m3

# Local media tools for the full analysis path; omit when available on PATH.
# OpenAI Whisper is an additional local Python runtime dependency.
# DOVIDEO_FFMPEG_DIR=/path/to/ffmpeg/bin
# DOVIDEO_TESSERACT_PATH=/path/to/tesseract
# DOVIDEO_WHISPER_MODEL=tiny.en

# R3 — RabbitMQ/Celery transport; use generated local values in .env.r2.local.
DOVIDEO_BROKER_URL=amqp://dovideo:replace-me@127.0.0.1:5672/%2F
RABBITMQ_DEFAULT_USER=dovideo
RABBITMQ_DEFAULT_PASS=replace-me
DOVIDEO_CELERY_QUEUE=dovideo.analysis
DOVIDEO_CELERY_EXCHANGE=dovideo.analysis
DOVIDEO_CELERY_ROUTING_KEY=dovideo.analysis
DOVIDEO_CELERY_DLX=dovideo.analysis.dlx
DOVIDEO_CELERY_DLQ=dovideo.analysis.dlq
DOVIDEO_CELERY_DL_ROUTING_KEY=dovideo.analysis.dead
DOVIDEO_CELERY_TASK_NAME=dovideo.analysis.deliver
DOVIDEO_CELERY_RETRY_COUNTDOWN_SECONDS=0.25

# X1 restricted model-issued read-only tools.  Rollout is opt-in and the
# existing X1-A/B bounds remain hard ceilings (per-round <= 4, total <= 12,
# ToolResult <= 65536 bytes).
DOVIDEO_AGENT_TOOL_CALLING_ENABLED=false
# DOVIDEO_AGENT_TOOL_REQUEST_LIMIT_PER_ROUND=4
# DOVIDEO_AGENT_TOOL_REQUEST_LIMIT_TOTAL=12

# J1 automatic model routing.  Disabled by default; enabling it requires the
# server-side Jev settings below.  FAST/DEEP are disabled when their model
# aliases are absent.  BALANCED falls back to DOVIDEO_MODEL automatically.
DOVIDEO_MODEL_ROUTING_ENABLED=false
# The default transport preserves the existing TypeSafe Direct behavior.
# Direct transport uses its own endpoint and DOVIDEO_JEV_API_KEY.
# DOVIDEO_JEV_TRANSPORT=typesafe_direct
# DOVIDEO_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# DOVIDEO_JEV_MODEL=replace-with-configured-jev-model
# DOVIDEO_JEV_API_KEY=replace-me
# OpenRouter transport uses a distinct credential and a pinned Jev model.
# DOVIDEO_JEV_TRANSPORT=openrouter
# DOVIDEO_JEV_MODEL=typesafe/jev-1.13
# DOVIDEO_OPENROUTER_API_KEY=replace-me
# DOVIDEO_MODEL_ROUTING_CONFIDENCE_THRESHOLD=0.70
# DOVIDEO_FAST_MODEL=replace-with-fast-profile
# DOVIDEO_BALANCED_MODEL=replace-with-current-balanced-model
# DOVIDEO_DEEP_MODEL=replace-with-deep-profile
# DOVIDEO_MODEL_ROUTING_FAST_ENABLED=true
# DOVIDEO_MODEL_ROUTING_DEEP_ENABLED=true
# DOVIDEO_JEV_TIMEOUT_SECONDS=2.0
# DOVIDEO_JEV_MAX_ATTEMPTS=1
# DOVIDEO_JEV_RETRY_DELAY_SECONDS=0.0

# X3-C execution profiles. FAST and BALANCED may share a model only when their
# request settings differ. Leave DOVIDEO_BALANCED_REASONING_EFFORT unset to
# preserve the existing provider-default request behavior. The DEEP token cap
# matches BALANCED's current high-thinking API default output budget. These
# aliases do not enable routing; set DOVIDEO_MODEL_ROUTING_ENABLED only in a
# controlled smoke shell.
# OpenRouter model execution shares DOVIDEO_OPENROUTER_API_KEY with Jev but
# pins one serving provider and disables provider fallbacks. The OpenRouter
# execution transport also enforces data_collection=deny and zdr=true.
# Jev's routing decision remains separate from that execution provider pin.
# DOVIDEO_MODEL_TRANSPORT=openrouter
# DOVIDEO_MODEL_PROVIDER_TAG=nextbit/fp8
# DOVIDEO_MODEL_MODEL=deepseek/deepseek-v4.1-flash
# DOVIDEO_FAST_MODEL=deepseek/deepseek-v4.1-flash
# DOVIDEO_FAST_REASONING_EFFORT=none
# DOVIDEO_BALANCED_MODEL=deepseek/deepseek-v4.1-flash
# DOVIDEO_DEEP_MODEL=deepseek/deepseek-v4-pro-0813
# DOVIDEO_DEEP_REASONING_EFFORT=max
# DOVIDEO_DEEP_MAX_TOKENS=65536
